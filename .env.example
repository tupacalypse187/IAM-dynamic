# ============================================
# AI Provider Configuration
# ============================================
# Choose your LLM provider: gemini, openai, anthropic/claude, zhipu/glm, muse/meta, or openrouter
LLM_PROVIDER=gemini

# --- Gemini Configuration (Google) ---
GOOGLE_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-4-argon
# Alternatives: gemini-3.8-flash, gemini-3.6-flash, gemini-3.5-flash-lite

# --- OpenAI Configuration ---
# GPT-6 Astra (latest flagship)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-6-astra
# Alternatives: gpt-6.1-sol, gpt-6.1-terra, gpt-6-luna

# --- Anthropic Claude Configuration ---
# Claude Opus 5.5 (latest) - flagship model
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
# Alternatives: claude-fable-5-1, claude-sonnet-5-5, claude-haiku-5-5

# --- Z.AI GLM Configuration (Global Platform) ---
# GLM-5.3 (latest) - flagship model via api.z.ai
# ZAI_API_KEY=...
# ZAI_MODEL=glm-5.3
# Alternatives: glm-5.3-flash, glm-5.2, glm-5.1, glm-5, glm-4.7

# --- Meta Muse Configuration (Meta Model API) ---
# Muse Wonder 1.0 (latest flagship) via api.meta.ai
# MUSE_API_KEY=...
# MUSE_MODEL=muse-spark-1.3-contributor
# Alternatives: muse-wonder-1.0, muse-spark-1.3, muse-spark-1.2, muse-spark-1.1

# --- OpenRouter Configuration (Gateway) ---
# One API key for many vendors' models (vendor/model slugs)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=z-ai/glm-5.3
# Alternatives: openai/gpt-6-astra, anthropic/claude-opus-5.5, google/gemini-4-argon, meta/muse-spark-1.3

# ============================================
# AWS Configuration
# ============================================
AWS_ACCOUNT_ID=123456789012
AWS_ROLE_NAME=AgentPOCSessionRole  # Role to be assumed by the app

# ============================================
# Slack Integration (Optional)
# ============================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================
# Telegram Integration (Optional)
# ============================================
# 1. Message @BotFather on Telegram → /newbot → copy the API token
# 2. Send your bot any message (press Start), then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id":...}
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=123456789

# ============================================
# Authentication (optional)
# ============================================
# In-app registration is ON by default: open the login page, create an
# account, and the first user becomes the administrator. Set these only
# to seed a legacy admin or lock registration down:
# AUTH_USERNAME=admin
# AUTH_PASSWORD_HASH=$2b$12$...   # python backend/scripts/hash_password.py
# JWT_SECRET=random-secret-32-chars
# AUTH_ALLOW_REGISTRATION=false    # invite-only: provision via setup-auth.sh
# AUTH_USERS_DB=users.db           # SQLite user database (backend dir)
# TURNSTILE_SECRET_KEY=0x...       # Cloudflare Turnstile server key

# ============================================
# Approval Configuration
# ============================================
APPROVER_NAME=Admin
